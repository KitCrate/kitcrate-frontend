{
  "name": "kitcrate-frontend",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@kitcrate/web",
    "build": "npm run build --workspace=@kitcrate/web",
    "lint": "npm run lint --workspace=@kitcrate/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
